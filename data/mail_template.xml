<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_template_widerruf_confirmation" model="mail.template">
        <field name="name">Widerruf: Eingangsbestätigung</field>
        <field name="model_id" ref="model_widerruf_record"/>
        <field name="subject">Eingangsbestätigung zu Ihrem Widerruf ${object.name}</field>
        <field name="email_from">${(object.company_id.email if object.company_id.email else user.email_formatted) | safe}</field>
        <field name="email_to">${object.customer_email}</field>
        <field name="auto_delete" eval="False"/>
        <field name="body_html" type="html">
            <div style="font-family: Arial, sans-serif; font-size: 14px; color: #222;">
                <p>Guten Tag <t t-out="object.customer_name"/>,</p>
                <p>wir bestätigen den Eingang Ihres Widerrufs. Nachfolgend finden Sie die von Ihnen übermittelten Angaben:</p>
                <table style="border-collapse: collapse; width: 100%; max-width: 700px;" cellpadding="6">
                    <tr><td style="border: 1px solid #ddd; font-weight: bold; width: 220px;">Vorgangsnummer</td><td style="border: 1px solid #ddd;"><t t-out="object.name"/></td></tr>
                    <tr><td style="border: 1px solid #ddd; font-weight: bold;">Name</td><td style="border: 1px solid #ddd;"><t t-out="object.customer_name"/></td></tr>
                    <tr><td style="border: 1px solid #ddd; font-weight: bold;">E-Mail</td><td style="border: 1px solid #ddd;"><t t-out="object.customer_email"/></td></tr>
                    <tr><td style="border: 1px solid #ddd; font-weight: bold;">Bestell- oder Rechnungsnummer</td><td style="border: 1px solid #ddd;"><t t-out="object.order_reference"/></td></tr>
                    <tr><td style="border: 1px solid #ddd; font-weight: bold;">Art des Widerrufs</td><td style="border: 1px solid #ddd;"><t t-out="dict(object._fields['withdrawal_type'].selection).get(object.withdrawal_type)"/></td></tr>
                    <tr><td style="border: 1px solid #ddd; font-weight: bold;">Mitteilung</td><td style="border: 1px solid #ddd;"><t t-out="object.message or '-'"/></td></tr>
                </table>
                <p style="margin-top: 20px;">Diese Nachricht bestätigt den technischen Eingang Ihrer Erklärung. Die weitere Bearbeitung erfolgt im Anschluss durch unser Team.</p>
                <p>Mit freundlichen Grüßen</p>
                <p><t t-out="user.company_id.name"/></p>
            </div>
        </field>
    </record>

    <record id="mail_template_widerruf_internal_notification" model="mail.template">
        <field name="name">Widerruf: Interne Benachrichtigung</field>
        <field name="model_id" ref="model_widerruf_record"/>
        <field name="subject">Neuer Widerruf ${object.name}</field>
        <field name="email_from">${(object.company_id.email if object.company_id.email else user.email_formatted) | safe}</field>
        <field name="email_to">${ctx.get('widerruf_internal_notify_email')}</field>
        <field name="auto_delete" eval="False"/>
        <field name="body_html" type="html">
            <div style="font-family: Arial, sans-serif; font-size: 14px; color: #222;">
                <p>Es wurde ein neuer Widerruf über die Website eingereicht.</p>
                <table style="border-collapse: collapse; width: 100%; max-width: 700px;" cellpadding="6">
                    <tr><td style="border: 1px solid #ddd; font-weight: bold; width: 220px;">Vorgangsnummer</td><td style="border: 1px solid #ddd;"><t t-out="object.name"/></td></tr>
                    <tr><td style="border: 1px solid #ddd; font-weight: bold;">Name</td><td style="border: 1px solid #ddd;"><t t-out="object.customer_name"/></td></tr>
                    <tr><td style="border: 1px solid #ddd; font-weight: bold;">E-Mail</td><td style="border: 1px solid #ddd;"><t t-out="object.customer_email"/></td></tr>
                    <tr><td style="border: 1px solid #ddd; font-weight: bold;">Bestell- oder Rechnungsnummer</td><td style="border: 1px solid #ddd;"><t t-out="object.order_reference"/></td></tr>
                    <tr><td style="border: 1px solid #ddd; font-weight: bold;">Status</td><td style="border: 1px solid #ddd;"><t t-out="dict(object._fields['state'].selection).get(object.state)"/></td></tr>
                </table>
                <p style="margin-top: 20px;">Bitte öffnen Sie den Vorgang in Odoo und bearbeiten Sie den Widerruf.</p>
            </div>
        </field>
    </record>

    <record id="mail_template_widerruf_status_update" model="mail.template">
        <field name="name">Widerruf: Statusänderung an Kunden</field>
        <field name="model_id" ref="model_widerruf_record"/>
        <field name="subject">Statusänderung zu Ihrem Widerruf ${object.name}</field>
        <field name="email_from">${(object.company_id.email if object.company_id.email else user.email_formatted) | safe}</field>
        <field name="email_to">${object.customer_email}</field>
        <field name="auto_delete" eval="False"/>
        <field name="body_html" type="html">
            <div style="font-family: Arial, sans-serif; font-size: 14px; color: #222;">
                <p>Guten Tag <t t-out="object.customer_name"/>,</p>
                <p>der Status Ihres Widerrufs wurde aktualisiert.</p>
                <table style="border-collapse: collapse; width: 100%; max-width: 700px;" cellpadding="6">
                    <tr><td style="border: 1px solid #ddd; font-weight: bold; width: 220px;">Vorgangsnummer</td><td style="border: 1px solid #ddd;"><t t-out="object.name"/></td></tr>
                    <tr><td style="border: 1px solid #ddd; font-weight: bold;">Bestell- oder Rechnungsnummer</td><td style="border: 1px solid #ddd;"><t t-out="object.order_reference"/></td></tr>
                    <tr><td style="border: 1px solid #ddd; font-weight: bold;">Aktueller Status</td><td style="border: 1px solid #ddd;"><t t-out="dict(object._fields['state'].selection).get(object.state)"/></td></tr>
                </table>
                <p style="margin-top: 20px;">Diese E-Mail informiert Sie über den aktuellen Bearbeitungsstand.</p>
                <p>Mit freundlichen Grüßen</p>
                <p><t t-out="user.company_id.name"/></p>
            </div>
        </field>
    </record>
</odoo>
