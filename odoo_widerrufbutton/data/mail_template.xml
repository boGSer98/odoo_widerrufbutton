<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="mail_template_widerruf_confirmation" model="mail.template">
        <field name="name">Withdrawal: receipt confirmation</field>
        <field name="model_id" ref="model_widerruf_record"/>
        <field name="subject">Receipt confirmation for your withdrawal {{ object.name }}</field>
        <field name="email_from">{{ object.company_id.partner_id.email_formatted or user.email_formatted }}</field>
        <field name="email_to">{{ object.customer_email }}</field>
        <field name="lang">{{ object.partner_id.lang or ctx.get('lang') or 'de_DE' }}</field>
        <field name="auto_delete" eval="False"/>
        <field name="body_html" type="html"><div>
            <p>Hello <t t-out="object.customer_name"/>,</p>
            <p>We confirm receipt of your declaration. Your information is shown below.</p>
            <table cellpadding="6">
                <tr><th>Reference</th><td><t t-out="object.name"/></td></tr>
                <tr><th>Received at</th><td><t t-out="format_datetime(object.received_at or object.create_date)"/></td></tr>
                <tr><th>Name</th><td><t t-out="object.customer_name"/></td></tr>
                <tr><th>Email</th><td><t t-out="object.customer_email"/></td></tr>
                <tr><th>Order or invoice reference</th><td><t t-out="object.order_reference"/></td></tr>
                <tr><th>Withdrawal type</th><td><t t-out="dict(object._fields['withdrawal_type']._description_selection(object.env)).get(object.withdrawal_type)"/></td></tr>
                <tr><th>Message</th><td><t t-out="object.message or '-'"/></td></tr>
                <tr><th>Status</th><td><t t-out="dict(object._fields['state']._description_selection(object.env)).get(object.state)"/></td></tr>
            </table>
            <p>This email confirms technical receipt or provides a processing update. It is not a decision on the legal validity of the withdrawal.</p>
            <p>Kind regards</p><p><t t-out="object.company_id.name"/></p>
        </div></field>
    </record>
    <record id="mail_template_widerruf_internal_notification" model="mail.template">
        <field name="name">Withdrawal: internal notification</field>
        <field name="model_id" ref="model_widerruf_record"/>
