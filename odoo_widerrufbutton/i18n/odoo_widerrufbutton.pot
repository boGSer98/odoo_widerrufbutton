#. module: odoo_widerrufbutton
#: model:mail.template,body_html:odoo_widerrufbutton.mail_template_widerruf_internal_notification
msgid ""
"<div>\n"
"            <p>Hello <t t-out=\"object.customer_name\"/>,</p>\n"
"            <p>A new declaration has been received. Please review the withdrawal in Odoo.</p>\n"
"            <table cellpadding=\"6\">\n"
"                <tr><th>Reference</th><td><t t-out=\"object.name\"/></td></tr>\n"
"                <tr><th>Received at</th><td><t t-out=\"format_datetime(object.received_at or object.create_date)\"/></td></tr>\n"
"                <tr><th>Name</th><td><t t-out=\"object.customer_name\"/></td></tr>\n"
"                <tr><th>Email</th><td><t t-out=\"object.customer_email\"/></td></tr>\n"
"                <tr><th>Order or invoice reference</th><td><t t-out=\"object.order_reference\"/></td></tr>\n"
"                <tr><th>Withdrawal type</th><td><t t-out=\"dict(object._fields['withdrawal_type']._description_selection(object.env)).get(object.withdrawal_type)\"/></td></tr>\n"
"                <tr><th>Message</th><td><t t-out=\"object.message or '-'\"/></td></tr>\n"
"                <tr><th>Status</th><td><t t-out=\"dict(object._fields['state']._description_selection(object.env)).get(object.state)\"/></td></tr>\n"
"            </table>\n"
"            <p>This email confirms technical receipt or provides a processing update. It is not a decision on the legal validity of the withdrawal.</p>\n"
"            <p>Kind regards</p><p><t t-out=\"object.company_id.name\"/></p>\n"
"        </div>"
msgstr ""

