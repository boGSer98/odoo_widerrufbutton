<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_widerruf" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.widerruf</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Withdrawal form" string="Withdrawal form" name="odoo_widerrufbutton">
                    <block title="Website and form" name="widerruf_website_form">
                        <setting string="Show footer button" help="Show or hide the withdrawal button in the website footer.">
                            <field name="widerruf_footer_button_enabled"/>
                        </setting>
                        <setting string="Introduction" help="Text displayed above the withdrawal form.">
                            <field name="widerruf_customer_intro_text" placeholder="Introduction for customers"/>
                        </setting>
                        <setting string="Enable file uploads" help="Allow optional attachments to the withdrawal.">
                            <field name="widerruf_upload_enabled"/>
                        </setting>
                        <setting string="Allowed file extensions" help="Comma-separated allowed file extensions without a dot.">
                            <field name="widerruf_allowed_file_extensions" placeholder="pdf,jpg,jpeg,png"/>
                        </setting>
                        <setting string="Maximum upload size" help="Maximum size of one attachment in MB.">
                            <field name="widerruf_max_upload_size_mb"/>
                        </setting>
                    </block>
                    <block title="Customer portal" name="widerruf_portal">
                        <setting string="Show portal view" help="Show received withdrawals linked to the verified customer account.">
                            <field name="widerruf_show_portal"/>
                        </setting>
                    </block>
                    <block title="Notifications and activities" name="widerruf_notifications">
                        <setting string="Send internal email" help="Queue an internal email for each new withdrawal.">
                            <field name="widerruf_send_internal_mail"/>
                        </setting>
                        <setting string="Internal notification address" help="Recipient of internal withdrawal notifications.">
                            <field name="widerruf_internal_notify_email" placeholder="widerruf@example.com"/>
                        </setting>
                        <setting string="Create activity" help="Create a to-do activity for each new withdrawal.">
                            <field name="widerruf_create_activity"/>
                        </setting>
                        <setting string="Responsible user" help="User assigned to the activity.">
                            <field name="widerruf_activity_user_id"/>
                        </setting>
                        <setting string="Activity deadline" help="Days until the activity is due.">
                            <field name="widerruf_activity_deadline_days"/>
                        </setting>
                        <setting string="Email customers on status changes" help="Queue a customer email when the status changes.">
                            <field name="widerruf_send_customer_status_mail"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
