<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <template id="widerruf_footer_link" inherit_id="website.layout" name="Withdrawal footer link">
  <xpath expr="//footer" position="inside"><t t-if="request.env['ir.config_parameter'].sudo().get_param('odoo_widerrufbutton.footer_button_enabled', 'True') in ('True','true','1')">
   <div class="o_widerruf_footer_wrapper container py-3"><a href="/widerruf" class="btn btn-outline-primary">Withdraw from contract</a></div>
  </t></xpath>
 </template>
 <template id="widerruf_page" name="Withdraw from contract"><t t-call="website.layout"><div id="wrap" class="o_widerruf_page"><section class="container py-5">
  <h1>Withdraw from contract</h1><p class="lead"><t t-out="intro_text"/></p>
  <div t-if="errors" class="alert alert-danger" role="alert"><ul><li t-foreach="errors.values()" t-as="error"><t t-out="error"/></li></ul></div>
  <form action="/widerruf/pruefen" method="post" enctype="multipart/form-data" class="o_widerruf_form">
   <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="draft" t-att-value="draft"/>
   <div class="o_widerruf_honeypot" aria-hidden="true"><input type="text" name="website_url" tabindex="-1" autocomplete="off"/></div>
   <div class="mb-3"><label for="customer_name" class="form-label">Name *</label><input id="customer_name" name="customer_name" class="form-control" required="required" maxlength="200" t-att-value="form_values.get('customer_name','')"/></div>
   <div class="mb-3"><label for="customer_email" class="form-label">Email *</label><input id="customer_email" name="customer_email" type="email" class="form-control" required="required" maxlength="254" t-att-value="form_values.get('customer_email','')"/></div>
   <div class="mb-3"><label for="order_reference" class="form-label">Order or invoice reference *</label><input id="order_reference" name="order_reference" class="form-control" required="required" maxlength="128" t-att-value="form_values.get('order_reference','')"/></div>
   <div class="mb-3"><label for="withdrawal_type" class="form-label">Withdrawal type</label><select id="withdrawal_type" name="withdrawal_type" class="form-select"><t t-foreach="withdrawal_types" t-as="kind"><option t-att-value="kind[0]" t-att-selected="'selected' if form_values.get('withdrawal_type','full')==kind[0] else None"><t t-out="kind[1]"/></option></t></select></div>
   <div class="mb-3"><label for="message" class="form-label">Message</label><textarea id="message" name="message" class="form-control" rows="5" maxlength="10000"><t t-out="form_values.get('message','')"/></textarea></div>
   <div class="mb-3" t-if="upload_enabled"><label for="attachments" class="form-label">Optional attachments</label><input id="attachments" name="attachments" type="file" multiple="multiple" accept=".pdf,.jpg,.jpeg,.png" class="form-control"/><p class="form-text">Up to three PDF, JPG or PNG files; the configured size limit applies.</p><p class="form-text">Attachments may not exceed 10 MB in total.</p></div>
   <ul t-if="existing_files"><li t-foreach="existing_files" t-as="file"><t t-out="file.name"/></li></ul>
   <p>Fields marked * are required. You can review your declaration before submitting it.</p>
   <button class="btn btn-primary" type="submit">Review details</button>
  </form>
 </section></div></t></template>
 <template id="widerruf_review_page" name="Review withdrawal"><t t-call="website.layout"><div id="wrap"><section class="container py-5">
  <h1>Review details</h1><p>Please check your details. Your declaration is submitted only when you press the confirmation button.</p>
  <dl class="row"><dt class="col-sm-4">Name</dt><dd class="col-sm-8"><t t-out="form_values.get('customer_name')"/></dd>
   <dt class="col-sm-4">Email</dt><dd class="col-sm-8"><t t-out="form_values.get('customer_email')"/></dd>
   <dt class="col-sm-4">Order or invoice reference</dt><dd class="col-sm-8"><t t-out="form_values.get('order_reference')"/></dd>
   <dt class="col-sm-4">Withdrawal type</dt><dd class="col-sm-8"><t t-out="withdrawal_type_label"/></dd>
   <dt class="col-sm-4">Message</dt><dd class="col-sm-8"><t t-out="form_values.get('message') or '-'"/></dd></dl>
  <ul t-if="existing_files"><li t-foreach="existing_files" t-as="file"><t t-out="file.name"/></li></ul>
  <form action="/widerruf/bestaetigen" method="post" class="d-inline-block me-2"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="payload" t-att-value="payload"/><button class="btn btn-primary" type="submit">Confirm withdrawal</button></form>
  <a t-att-href="'/widerruf?draft='+payload" class="btn btn-secondary">Correct details</a>
 </section></div></t></template>
 <template id="widerruf_success_page" name="Withdrawal received"><t t-call="website.layout"><div id="wrap"><section class="container py-5">
  <h1>Your withdrawal has been received</h1><p>Your reference: <strong><t t-out="record.name"/></strong></p>
  <p t-if="record.confirmation_mail_state == 'sent'">The confirmation email has been sent.</p>
  <p t-elif="record.confirmation_mail_state == 'outgoing'">Your confirmation email has been queued for delivery.</p>
  <p t-else="">Your declaration has been recorded. The confirmation email could not be prepared or sent. Please contact us if needed.</p>
  <a href="/" class="btn btn-primary">Back to homepage</a>
 </section></div></t></template>
</odoo>
