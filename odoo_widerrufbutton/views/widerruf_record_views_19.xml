<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_widerruf_record_list_19" model="ir.ui.view">
        <field name="name">widerruf.record.list.19</field>
        <field name="model">widerruf.record</field>
        <field name="arch" type="xml">
            <list string="Withdrawals">
                <field name="name"/>
                <field name="create_date"/>
                <field name="customer_name"/>
                <field name="customer_email"/>
                <field name="order_reference"/>
                <field name="withdrawal_type"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_widerruf_record_form_19" model="ir.ui.view">
        <field name="name">widerruf.record.form.19</field>
        <field name="model">widerruf.record</field>
        <field name="arch" type="xml">
            <form string="Withdrawal">
                <header>
                    <button name="action_set_in_progress" type="object" string="In progress" class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_set_done" type="object" string="Done" class="btn-primary" invisible="state == 'done'"/>
                    <button name="action_set_cancelled" type="object" string="Close without action" invisible="state == 'cancelled'"/>
                    <button name="action_send_confirmation_mail" type="object" string="Queue confirmation again"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group string="Customer details">
                            <field name="customer_name"/>
                            <field name="customer_email"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="order_reference"/>
                            <field name="withdrawal_type"/>
                            <field name="message"/>
                        </group>
                        <group string="Origin">
                            <field name="website_id" readonly="1"/><field name="company_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Email status"><field name="confirmation_mail_state"/><field name="mail_error"/>
                        <field name="confirmation_mail_sent" readonly="1"/>
                        <field name="confirmation_mail_sent_at" readonly="1"/>
                        <field name="internal_mail_sent" readonly="1"/>
                        <field name="internal_mail_sent_at" readonly="1"/>
                        <field name="customer_status_mail_sent_at" readonly="1"/>
                    </group>
                    <notebook><page string="Original receipt"><field name="received_at"/><field name="original_submission" readonly="1"/></page>
                        <page string="Attachments">
                            <field name="attachment_ids" widget="many2many_binary" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_widerruf_record" model="ir.actions.act_window">
        <field name="name">Withdrawals</field>
        <field name="res_model">widerruf.record</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_widerruf_root" name="Withdrawals" sequence="80" groups="odoo_widerrufbutton.group_widerruf_user,base.group_system"/>
    <menuitem id="menu_widerruf_records" name="Withdrawals" parent="menu_widerruf_root" action="action_widerruf_record" sequence="10"/>
</odoo>
