<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_widerruf_smartbutton" model="ir.ui.view">
        <field name="name">sale.order.form.widerruf.smartbutton</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet//div[@name='button_box']" position="inside">
                <button name="action_view_widerrufe"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-undo"
                        invisible="widerruf_count == 0">
                    <field name="widerruf_count" widget="statinfo" string="Widerrufe"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
