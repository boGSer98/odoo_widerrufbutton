<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_widerruf_record_tree" model="ir.ui.view">
        <field name="name">widerruf.record.tree</field>
        <field name="model">widerruf.record</field>
        <field name="arch" type="xml">
            <list string="Widerrufe">
                <field name="name"/>
                <field name="create_date"/>
                <field name="customer_name"/>
                <field name="customer_email"/>
                <field name="partner_id"/>
                <field name="order_reference"/>
                <field name="reference_match_type"/>
                <field name="withdrawal_type"/>
                <field name="attachment_count"/>
                <field name="email_matches_document"/>
                <field name="state"/>
                <field name="confirmation_mail_sent"/>
                <field name="internal_mail_sent"/>
            </list>
        </field>
    </record>

    <record id="view_widerruf_record_form" model="ir.ui.view">
        <field name="name">widerruf.record.form</field>
        <field name="model">widerruf.record</field>
        <field name="arch" type="xml">
            <form string="Widerruf">
                <header>
                    <button name="action_set_in_progress" type="object" string="In Bearbeitung" class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_set_done" type="object" string="Erledigt" class="btn-primary" invisible="state == 'done'"/>
                    <button name="action_set_cancelled" type="object" string="Abbrechen" invisible="state == 'cancelled'"/>
                    <button name="action_send_confirmation_mail" type="object" string="E-Mail erneut senden"/>
                    <field name="state" widget="statusbar" statusbar_visible="confirmed,in_progress,done"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="not email_mismatch_warning">
                        <field name="email_mismatch_warning" readonly="1" nolabel="1"/>
                    </div>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group string="Kundendaten">
                            <field name="customer_name"/>
                            <field name="customer_email"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="order_reference"/>
                            <field name="withdrawal_type"/>
                        </group>
                        <group string="Odoo-Verknüpfung">
                            <field name="website_id" readonly="1"/>
                            <field name="reference_match_type" readonly="1"/>
                            <field name="sale_order_id" readonly="1"/>
                            <field name="invoice_id" readonly="1"/>
                            <field name="email_matches_document" readonly="1"/>
                            <field name="attachment_count" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="E-Mail-Status">
                            <field name="confirmation_mail_sent" readonly="1"/>
                            <field name="confirmation_mail_sent_at" readonly="1"/>
                            <field name="internal_mail_sent" readonly="1"/>
                            <field name="internal_mail_sent_at" readonly="1"/>
                            <field name="customer_status_mail_sent_at" readonly="1"/>
                        </group>
                    </group>
                    <group string="Mitteilung">
                        <field name="message" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Anhänge">
                            <field name="attachment_ids" widget="many2many_binary" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_widerruf_record_search" model="ir.ui.view">
        <field name="name">widerruf.record.search</field>
        <field name="model">widerruf.record</field>
        <field name="arch" type="xml">
            <search string="Widerrufe suchen">
                <field name="name"/>
                <field name="customer_name"/>
                <field name="customer_email"/>
                <field name="partner_id"/>
                <field name="order_reference"/>
                <filter name="confirmed" string="Bestätigt" domain="[('state','=','confirmed')]"/>
                <filter name="in_progress" string="In Bearbeitung" domain="[('state','=','in_progress')]"/>
                <filter name="done" string="Erledigt" domain="[('state','=','done')]"/>
                <group expand="0" string="Gruppieren nach">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_partner" string="Kundenkonto" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_reference" string="Referenzverknüpfung" context="{'group_by': 'reference_match_type'}"/>
                    <filter name="group_type" string="Art" context="{'group_by': 'withdrawal_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_widerruf_record" model="ir.actions.act_window">
        <field name="name">Widerrufe</field>
        <field name="res_model">widerruf.record</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_widerruf_record_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Noch keine Widerrufe vorhanden</p>
            <p>Über die Website eingehende Widerrufe werden hier angezeigt.</p>
        </field>
    </record>

    <menuitem id="menu_widerruf_root" name="Widerrufe" sequence="80" web_icon="sale_management,static/description/icon.png"/>
    <menuitem id="menu_widerruf_records" name="Widerrufe" parent="menu_widerruf_root" action="action_widerruf_record" sequence="10"/>

</odoo>
